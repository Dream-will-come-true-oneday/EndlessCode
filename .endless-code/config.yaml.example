# Endless Code 配置文件示例
# 复制此文件为 config.yaml 并填写实际的 API 密钥
#
# 配置文件查找顺序：
#   1. 当前目录 .endless-code/config.yaml
#   2. 用户目录 ~/.config/endless-code/config.yaml
#
# 上下文窗口与压缩阈值：
#   所有压缩阈值按 context_window 等比推导（比例表内置，不可配置）；
#   填 1000000 时等于历史固定常量，填 128000 等小值时自动压缩仍正常触发。
#   对照表见 README 的「上下文窗口与自动压缩」一节。

providers:
  - name: anthropic
    protocol: anthropic
    model: claude-3-5-sonnet-latest
    api_key: $ANTHROPIC_API_KEY      # 环境变量引用
    context_window: 1000000          # 可选；未配置时默认 1000000，阈值等比缩放

  - name: deepseek
    protocol: openai                   # DeepSeek 走 OpenAI 兼容协议
    model: deepseek-chat
    base_url: https://api.deepseek.com
    api_key: $DEEPSEEK_API_KEY        # 环境变量引用
    context_window: 1000000           # 可选；改小（如 128000）后压缩阈值同步缩小

  - name: openai
    protocol: openai
    model: gpt-4o
    # base_url 可省略，默认使用 OpenAI 官方端点
    api_key: $OPENAI_API_KEY           # 环境变量引用
    thinking: false                    # OpenAI 忽略此字段
    context_window: 1000000           # 可选；详见 README 阈值对照表

# Endless Code 配置文件示例
# 复制此文件为 config.yaml 并填写实际的 API 密钥
#
# 配置文件查找顺序：
#   1. 当前目录 .endless-code/config.yaml
#   2. 用户目录 ~/.config/endless-code/config.yaml

providers:
  - name: anthropic
    protocol: anthropic
    model: claude-3-5-sonnet-latest
    api_key: $ANTHROPIC_API_KEY      # 环境变量引用
    context_window: 200000           # 可选；未配置时 Anthropic 默认 200000

  - name: deepseek
    protocol: deepseek
    model: deepseek-chat
    base_url: https://api.deepseek.com
    api_key: $DEEPSEEK_API_KEY        # 环境变量引用
    thinking: false                    # 是否启用扩展思考（仅 DeepSeek 生效）
    context_window: 128000             # 可选；未配置时 DeepSeek 默认 128000

  - name: openai
    protocol: openai
    model: gpt-4o
    # base_url 可省略，默认使用 OpenAI 官方端点
    api_key: $OPENAI_API_KEY           # 环境变量引用
    thinking: false                    # OpenAI 忽略此字段
    context_window: 128000             # 可选；未配置时 OpenAI 默认 128000
